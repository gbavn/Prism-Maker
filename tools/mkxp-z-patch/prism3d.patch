+static bool isValidUTF8(const std::string &str) {
+    const unsigned char *p = (const unsigned char *)str.c_str();
+    size_t left = str.size();
+
+    while (left > 0) {
+        unsigned char c = *p;
+        size_t extra;
+
+        if (c < 0x80)                       extra = 0;
+        else if ((c & 0xE0) == 0xC0)        extra = 1;
+        else if ((c & 0xF0) == 0xE0)        extra = 2;
+        else if ((c & 0xF8) == 0xF0)        extra = 3;
+        else                                return false;
+
+        if (extra >= left)
